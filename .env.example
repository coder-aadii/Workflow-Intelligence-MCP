# ==============================================================================
# Workflow Intelligence MCP — Environment Configuration Template
# ==============================================================================

# Application Environment (development, staging, production)
WORKFLOW_ENV=production

# Server Transport (stdio, sse, streamable-http, http, or unified)
SERVER_TRANSPORT=unified
SERVER_HOST=127.0.0.1
SERVER_PORT=8000

# Security & Authentication
# In production, MCP_AUTH_TOKEN is strictly mandatory for all network endpoints (/mcp, /sse).
# The server fails closed if exposed over network without an active token.
# TRUSTED_AUTH_GATEWAY alone cannot bypass authentication without an active token.
MCP_AUTH_TOKEN=replace_with_strong_random_token_minimum_32_chars
TRUSTED_AUTH_GATEWAY=false
ALLOWED_DATA_DIRS=sample-data,data,local
MAX_FILE_SIZE_BYTES=209715200

# Reliability & Execution Limits
ANALYSIS_TIMEOUT_SECONDS=60
QUERY_TIMEOUT_MS=30000

# PostgreSQL Database Persistence
# In production, default passwords like 'postgres:postgres' are strictly forbidden and will fail startup.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_secure_production_password_minimum_16_chars
POSTGRES_DB=workflow_intelligence
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# DuckDB Analytics Persistence (:memory: or path to persistent file)
DUCKDB_PATH=/app/data/procurement_costs.duckdb

# Redis Caching & Queue URL
REDIS_URL=redis://redis:6379/0

# Observability & Logging (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
