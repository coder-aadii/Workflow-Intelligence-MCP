.pytest_cache/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
htmlcov/
.tox/
.nox/

# Type Checking and Linters
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/

# Databases and Local Analytics Files
*.duckdb
*.duckdb.wal
